{
  
    "ReverseProxy": {
      "Routes": {
        "products-route": {
          "ClusterId": "products-cluster",
          "Match": {
            "Path": "/products/{**catch-all}"
          },
          "Transforms": [
            {
              "PathRemovePrefix": "/products"
            }
          ]
        },

        "orders-route": {
          "ClusterId": "orders-cluster",
          "Match": {
            "Path": "/orders/{**catch-all}"
          },
          "Transforms": [
            {
              "PathRemovePrefix": "/orders"
            }
          ]
        },

        "notifications-route": {
          "ClusterId": "notifications-cluster",
          "Match": {
            "Path": "/notifications/{**catch-all}"
          },
          "Transforms": [
            {
              "PathRemovePrefix": "/notifications"
            }
          ]
        }
      },

      "Clusters": {
        "products-cluster": {
          "Destinations": {
            "productservice": {
              "Address": "http://productservice:8080/"
            }
          }
        },

        "orders-cluster": {
          "Destinations": {
            "orderservice": {
              "Address": "http://orderservice:8080/"
            }
          }
        },

        "notifications-cluster": {
          "Destinations": {
            "notificationservice": {
              "Address": "http://notificationservice:8080/"
            }
          }
        }
      }
    }
  ,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
